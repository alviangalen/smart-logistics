# ==============================================================================
# SMART-LOGISTICS // AWS CLOUD OPERATIONS & TELEMETRY PLATFORM
# SPECIFICATION & ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Petunjuk:
# 1. Salin berkas ini ke `.env.local` di direktori root.
# 2. Isi nilai endpoint target backend riil dari arsitektur AWS Anda.
# 3. Seluruh endpoint dapat diuji dan dioverride secara live melalui antarmuka
#    dashboard (Tombol "SETTING ENDPOINT" pada Header).
# ==============================================================================

# GLOBAL AWS CREDENTIALS & REGION
VITE_AWS_REGION=ap-southeast-1
VITE_AWS_ACCOUNT_ID=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=

# ==============================================================================
# MODUL 1: INGESTION & CLUSTER HEALTH (COMPUTE & CONTAINERS)
# Target: EC2, Auto Scaling Group (ASG), ECS (Node.js), EKS (Golang)
# ==============================================================================
# Endpoint probe HTTP GET untuk memeriksa status kesehatan instans/klaster
VITE_EC2_HEALTH_ENDPOINT=
VITE_ASG_HEALTH_ENDPOINT=
VITE_ECS_HEALTH_ENDPOINT=
VITE_EKS_HEALTH_ENDPOINT=

# ==============================================================================
# MODUL 2: IOT TELEMETRY & COLD-CHAIN MONITOR (IOT & CACHING)
# Target: AWS IoT Core (MQTT over WebSocket), AWS IoT Events, Redis/ElastiCache
# ==============================================================================
# AWS IoT Core ATS Endpoint (e.g., xxxxx-ats.iot.ap-southeast-1.amazonaws.com)
VITE_IOT_CORE_ENDPOINT=
# WebSocket URL langsung (wss://...) untuk membaca stream payload sensor
VITE_IOT_WS_ENDPOINT=
# Topic MQTT armada rantai dingin
VITE_IOT_MQTT_TOPIC=logistics/fleet/coldchain/telemetry
# API cache telemetry Redis / ElastiCache untuk pembacaan state terakhir
VITE_REDIS_TELEMETRY_ENDPOINT=

# ==============================================================================
# MODUL 3: MAP & ASSET TRACKING (NETWORKING & LOCATION)
# Target: Amazon Location Service, Route 53, CloudFront
# ==============================================================================
# Nama peta yang dibuat pada Amazon Location Service
VITE_AWS_LOCATION_MAP_NAME=LogisticsFleetMap
# API Key (v1.public...) atau Cognito unauth role token untuk vector tile
VITE_AWS_LOCATION_API_KEY=
# URL kustom style-descriptor MapLibre GL (opsional jika menggunakan proxy/CDN)
VITE_LOCATION_STYLE_URL=
# Endpoint API backend untuk mengambil posisi geolokasi riil armada
VITE_ASSET_TRACKING_ENDPOINT=
# Endpoint API backend untuk status perimeter geofence
VITE_GEOFENCE_ENDPOINT=

# ==============================================================================
# MODUL 4: ORDER PIPELINE & EVENT INTEGRATION (INTEGRATION & DATABASE)
# Target: Step Functions, SQS, DynamoDB, RDS Aurora
# ==============================================================================
# Endpoint API Gateway untuk mengeksekusi state machine Step Functions (POST)
VITE_ORDER_API_ENDPOINT=
# ARN State Machine pemrosesan order
VITE_STEP_FUNCTIONS_ARN=
# Endpoint API Gateway untuk query daftar order tersimpan (DynamoDB / RDS)
VITE_ORDER_LIST_ENDPOINT=
# Endpoint API Gateway untuk polling detail status order per waybill
VITE_ORDER_STATUS_ENDPOINT=

# ==============================================================================
# MODUL 5: DOCUMENT & POD STORAGE (STORAGE)
# Target: Amazon S3 (Pre-signed URL Upload), S3 Glacier
# ==============================================================================
# Nama S3 Bucket penyimpanan bukti pengiriman (Proof of Delivery)
VITE_S3_BUCKET_NAME=smart-logistics-pod-storage
# Endpoint API backend untuk meminta S3 pre-signed upload URL (POST)
VITE_S3_PRESIGN_ENDPOINT=
# Endpoint API backend untuk listing objek dan storage class pada bucket (GET)
VITE_S3_LIST_ENDPOINT=

# ==============================================================================
# MODUL 6: MEDIA STREAMING (MEDIA SERVICES)
# Target: Amazon Kinesis Video Streams
# ==============================================================================
# Nama Kinesis Video Stream kamera armada
VITE_KINESIS_STREAM_NAME=fleet-dashcam-primary
# Master Playlist URL (.m3u8) hasil panggilan GetHLSStreamingSessionURL
VITE_KINESIS_HLS_ENDPOINT=
# Endpoint API Gateway backend untuk request dynamic streaming session URL (POST)
VITE_KINESIS_GET_MEDIA_ENDPOINT=

# ==============================================================================
# MODUL 7: PREDICTIVE ETA & ANALYTICS (ML & BIG DATA)
# Target: Amazon SageMaker (Real-time Endpoint), Amazon OpenSearch Service
# ==============================================================================
# Endpoint API Gateway menuju SageMaker Real-time Endpoint model estimasi ETA (POST)
VITE_SAGEMAKER_ENDPOINT=
# Endpoint Amazon OpenSearch Service untuk query teks penuh manifest kargo (GET/POST)
VITE_OPENSEARCH_ENDPOINT=
# Nama index OpenSearch untuk dokumen manifest kargo logistik
VITE_OPENSEARCH_INDEX=logistics-manifests

# ==============================================================================
# MODUL 8: OBSERVABILITY & CLOUD BUDGETS (GOVERNANCE & COST)
# Target: Amazon CloudWatch (Metrics & Alarms), AWS Budgets
# ==============================================================================
# Endpoint API Gateway untuk mengambil metrik performa CPU/RAM CloudWatch (GET)
VITE_CLOUDWATCH_METRICS_ENDPOINT=
# Endpoint API Gateway untuk mengambil daftar status CloudWatch Alarms (GET)
VITE_CLOUDWATCH_ALARMS_ENDPOINT=
# Endpoint API Gateway untuk mengambil batas kuota dan pengeluaran AWS Budgets (GET)
VITE_AWS_BUDGETS_ENDPOINT=
